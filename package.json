{
  "name": "prompt-cache-lab",
  "version": "0.1.0",
  "private": true,
  "description": "验证提示词结构变化对前缀缓存命中率的影响（OpenAI / Anthropic 两种 API 形态）",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "measure": "tsx --env-file-if-exists=.env.local src/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "openai": "^7.55.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
